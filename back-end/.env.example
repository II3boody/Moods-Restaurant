APP_ENV=development
DATABASE_URL=sqlite:///./moods.db
# PostgreSQL: postgresql+psycopg2://user:pass@localhost:5432/moods

# generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-please
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

FIRST_SUPERADMIN_EMAIL=superadmin@moods.com
FIRST_SUPERADMIN_PASSWORD=ChangeMe123!
FIRST_SUPERADMIN_NAME=Super Admin

# SMTP (optional - if empty, emails are printed to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@moods.com
